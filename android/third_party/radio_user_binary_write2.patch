+	const char* buf = reinterpret_cast<const char*>(X_N1);
+	size_t remaining = 2 * (size_t)this->N * sizeof(R);
+	while (remaining > 0)
+	{
+		ssize_t n = ::write(output_fd, buf, remaining);
+		if (n < 0)
+		{
+			if (errno == EINTR) continue;
+			throw spu::tools::runtime_error(__FILE__, __LINE__, __func__,
+				std::string("Unknown error during file writing: ") + std::strerror(errno));
+		}
+		buf += n;
+		remaining -= (size_t)n;
+	}
 }
 
